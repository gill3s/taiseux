# Compilation Linux de Taiseux (paquets .deb et AppImage) dans un conteneur Debian, pour l'architecture de l'hôte
# ou celle passée par --platform. Utilisé par build/linux.sh.
FROM docker.io/library/rust:1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev \
      libayatana-appindicator3-dev librsvg2-dev patchelf xdg-utils \
  && rm -rf /var/lib/apt/lists/*
RUN cargo install tauri-cli --version "^2" --locked
WORKDIR /src
